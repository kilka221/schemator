# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base Domain / URL (for schemator.ru production)
APP_URL="https://schemator.ru"

# Yandex Database (YDB Serverless) Configuration
# 1. Option A: Full Service Account JSON key (Recommended)
# YDB_SA_KEY='{"serviceAccountId":"...","accessKeyId":"...","privateKey":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
YDB_SA_KEY=

# 2. Option B: Separate credentials
YDB_DATABASE="/ru-central1/b1guc5cn5a6d63lgsuiq/etnjqd1tqkrk2upndh4i"
YDB_ENDPOINT="grpcs://ydb.serverless.yandexcloud.net:2135"
YDB_SERVICE_ACCOUNT_ID=
YDB_ACCESS_KEY_ID=
YDB_PRIVATE_KEY=
YDB_IAM_ENDPOINT="iam.api.cloud.yandex.net:443"

# Yandex OAuth Client ID
YANDEX_CLIENT_ID="c0f4c3f30ccf47088a44f3262ed4fe32"

# SMTP Email Configuration (for official email confirmation codes)
# By default connects to Yandex Mail SMTP (smtp.yandex.ru:465)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="auth@schemator.ru"
SMTP_PASS="your_yandex_app_password"
SMTP_FROM="Схематор <auth@schemator.ru>"


